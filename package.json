{
  "name": "paper-lens-zotero",
  "version": "0.2.5",
  "private": true,
  "description": "A small, native Zotero paper-reading companion",
  "author": "februarysea",
  "homepage": "https://github.com/februarysea/zotero-paper-lens",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/februarysea/zotero-paper-lens.git"
  },
  "bugs": { "url": "https://github.com/februarysea/zotero-paper-lens/issues" },
  "paperLens": { "releaseChannel": "beta" },
  "scripts": {
    "test": "node --test",
    "build": "python3 scripts/build.py",
    "check": "node scripts/check.cjs",
